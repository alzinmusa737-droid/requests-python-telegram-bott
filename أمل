<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دردشة أمل الذكية</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f3f2fd; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .chat-container { background: white; width: 100%; max-width: 400px; height: 85vh; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); display: flex; flex-direction: column; overflow: hidden; }
        .chat-header { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; padding: 20px; text-align: center; font-size: 20px; font-weight: bold; }
        .chat-box { flex: 1; padding: 20px; overflow-y: auto; background-color: #f8fafc; display: flex; flex-direction: column; }
        .message { margin-bottom: 15px; padding: 12px 15px; border-radius: 15px; max-width: 75%; font-size: 15px; line-height: 1.4; display: inline-block; }
        .user-msg { background-color: #e0e7ff; color: #1e1b4b; align-self: flex-start; border-bottom-left-radius: 2px; }
        .ai-msg { background-color: #4f46e5; color: white; align-self: flex-end; border-bottom-right-radius: 2px; text-align: right; }
        .input-area { padding: 15px; background: white; display: flex; gap: 10px; border-top: 1px solid #e2e8f0; }
        input { flex: 1; padding: 12px; border: 1px solid #cbd5e1; border-radius: 25px; outline: none; font-size: 15px; padding-right: 15px; }
        button { background: #4f46e5; color: white; border: none; padding: 12px 25px; border-radius: 25px; font-weight: bold; cursor: pointer; }
        button:hover { background: #4338ca; }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="chat-header">🤖 مساعد أمل الذكي</div>
    <div class="chat-box" id="chatBox">
        <div class="message ai-msg">🤖 مرحب بيكِ يا أمل! أنا هسي بقيت أذكى، جربي سلّمي عليّ أو أسألينّي عن الباسورد وشوفي حأرد كيف! 😉</div>
    </div>
    <div class="input-area">
        <input type="text" id="userInput" placeholder="اكتبي رسالتكِ هنا...">
        <button onclick="sendMessage()">إرسال</button>
    </div>
</div>

<script>
    function sendMessage() {
        let input = document.getElementById("userInput");
        let chatBox = document.getElementById("chatBox");
        let text = input.value.trim();
        
        if(text === "") return;

        // رسالة أمل
        let userDiv = document.createElement("div");
        userDiv.className = "message user-msg";
        userDiv.innerText = "أمل: " + text;
        chatBox.appendChild(userDiv);

        input.value = "";
        chatBox.scrollTop = chatBox.scrollHeight;

        // رد الـ AI الذكي بناءً على شروطك
        setTimeout(() => {
            let aiDiv = document.createElement("div");
            aiDiv.className = "message ai-msg";
            
            // تحويل النص لحروف صغيرة وفحص الكلمات المفتاحية
            if(text.includes("هلا") || text.includes("سلام") || text.includes("مرحب")) {
                aiDiv.innerText = "🤖 البوت: أهلاً وسهلاً بيكِ يا غالية! كيف أقدر أساعدكِ الليلة في رحلة البرمجة؟ ✨";
            } else if(text.includes("باسورد") || text.includes("كلمة مرور") || text.includes("حماية")) {
                aiDiv.innerText = "🤖 البوت: نصيحة أمنية فخمة: عشان تحمي حساباتكِ، لازم الباسورد يكون طويل وفيهو رموز زي (#, $, %) وما تديهو لأي زول نهائي! 🔐";
            } else if(text.includes("تطبيق")) {
                aiDiv.innerText = "🤖 البوت: شفتي كيف؟ هسي إحنا حولنا الواجهة لشات بنفسجي فخم جوة Acode وبقيت بفهمكِ طوالي! 🚀";
            } else {
                aiDiv.innerText = "🤖 البوت: رسالتكِ وصلتني وفهمتها، يلا علميني ردود جديدة عشان أبقى أذكى وأذكى! 👀";
            }
            
            chatBox.appendChild(aiDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }, 600);
    }
</script>

</body>
</html>
